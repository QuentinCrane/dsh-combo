{
  "name": "dsh-combo",
  "version": "0.6.0",
  "description": "PowerMode-style real-time streaming token and tool-call combo feedback for DeepSeek Harness, featuring 5 distinct presets, 6 synthesized audio themes, and a live HUD simulator.",
  "type": "module",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuentinCrane/dsh-combo.git"
  },
  "homepage": "https://github.com/QuentinCrane/dsh-combo#readme",
  "bugs": {
    "url": "https://github.com/QuentinCrane/dsh-combo/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "test": "node --import ./test/register.mjs --test test/host.test.mjs test/client.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "combo",
    "power-mode",
    "tool-calls"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
